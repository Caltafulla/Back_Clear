# Database
DATABASE_URL=mongodb://localhost:27017/algorithmic-challenges
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=development

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# AI Assistant - Choose ONE of the following (all have free tiers):
# Option 1: Groq (RECOMMENDED - Free tier: 14,400 requests/day)
# Get free API key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# Option 2: Google Gemini (Free tier available)
# Get free API key at: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key

# Option 3: Together AI (Free tier available)
# Get free API key at: https://api.together.xyz
# TOGETHER_API_KEY=your-together-api-key

# Option 4: Ollama (100% FREE - runs locally, no API key needed)
# Install from: https://ollama.ai
# Then run: ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# Option 5: OpenAI (Paid, but most reliable)
# OPENAI_API_KEY=your-openai-api-key

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

